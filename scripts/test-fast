#!/bin/bash
# Runs the tests as scripts/test does, but split into shards that run side by side, each a
# process of its own with its own throwaway home, temporary folder and hand-off log, so the
# suites that run a whole Browser no longer share settings or files. Within a shard, tests
# still run one at a time. For iterating; scripts/test stays the reference before a merge.
#   scripts/test-fast
#   scripts/test-fast --filter Agent --jobs 4
#   scripts/test-fast --list-shards
# Stops every shard after LITHIUM_TEST_MINUTES (10 by default). Shard logs stay in
# LITHIUM_TEST_OUT (a new folder in the temporary folder by default).
set -u
cd "$(dirname "$0")/.."

# Suites that play audio or video, or depend on WebKit hearing a page, all run in one shard,
# one after another: WebKit's media playback breaks when several of them run at once.
MEDIA_SUITES=(
    BrowserTests            # leavingAPlayingVideoPopsItOut plays a video
    NowPlayingTests         # the parsing half is quick; kept with the rest of its file
    NowPlayingBrowserTests  # follows which tab is heard
    NowPlayingPageTests     # plays audio in pages
    VideoPopoutTests        # plays video
    PageLayersTests         # watches a playing video for black frames
    YouTubeLiveTests        # plays a real YouTube video (only with LITHIUM_LIVE_TESTS=1)
)
# Seconds a suite without a measured time is assumed to take.
DEFAULT_SECONDS=5

minutes=${LITHIUM_TEST_MINUTES-10}
case $minutes in
    '' | *[!0-9]* | 0*)
        echo "scripts/test-fast: LITHIUM_TEST_MINUTES must be a whole number of minutes above 0, not '$minutes'." >&2
        exit 2 ;;
esac
cores=$(sysctl -n hw.ncpu)
jobs=$((cores / 2))
[ "$jobs" -gt 6 ] && jobs=6
[ "$jobs" -lt 1 ] && jobs=1

# --filter and --skip choose the tests here and never reach `swift test`: each shard gets a
# filter of its own, and SwiftPM ORs several --filter. The build gets every other argument
# except the ones only `swift test` knows, as in scripts/test.
filters=()
skips=()
build_args=()
test_args=()
scratch_path=0
list_shards=0
while [ $# -gt 0 ]; do
    case $1 in
        --jobs) jobs=${2-}; shift ;;
        --jobs=*) jobs=${1#--jobs=} ;;
        --filter) filters+=("${2-}"); shift ;;
        --filter=*) filters+=("${1#--filter=}") ;;
        --skip) skips+=("${2-}"); shift ;;
        --skip=*) skips+=("${1#--skip=}") ;;
        --list-shards) list_shards=1 ;;
        --parallel | --no-parallel | --num-workers | --num-workers=* | --list-tests | -l)
            echo "scripts/test-fast: $1 isn't supported: each shard runs its tests one at a time." >&2
            exit 2 ;;
        --xunit-output | --attachments-path) test_args+=("$1" "${2-}"); shift ;;
        --xunit-output=* | --attachments-path=*) test_args+=("$1") ;;
        --scratch-path | --scratch-path=*) scratch_path=1; build_args+=("$1"); test_args+=("$1") ;;
        *) build_args+=("$1"); test_args+=("$1") ;;
    esac
    shift
done
case $jobs in
    '' | *[!0-9]* | 0*)
        echo "scripts/test-fast: --jobs must be a whole number above 0, not '$jobs'." >&2
        exit 2 ;;
esac

# iCloud-synced folders tag build products with xattrs that break codesign; build outside them.
if [ "$scratch_path" -eq 0 ] && [ ! -L .build ]; then
    rm -rf .build
    mkdir -p "$HOME/Library/Caches/Lithium/build"
    ln -s "$HOME/Library/Caches/Lithium/build" .build
fi
# Generated by scripts/update-filters.py and not versioned; the build fails without the folder.
mkdir -p Sources/Lithium/Resources/Filters

swift build --build-tests ${build_args[@]+"${build_args[@]}"} || exit $?

out=${LITHIUM_TEST_OUT:-${TMPDIR:-/tmp}/lithium-test-fast-$(date +%Y%m%d-%H%M%S)}
out=${out%/}
mkdir -p "$out" || exit 2
timings="${XDG_CACHE_HOME:-$HOME/Library/Caches}/Lithium/test-timings.tsv"
homes=()
# Each shard's defaults suite is a file in the user's real Library/Preferences (see
# LITHIUM_DEFAULTS_SUITE below), named after its home. cfprefsd can write a suite's file back,
# empty, after the run ends, so each run also sweeps those of runs over for longer than the
# time limit.
preferences="$HOME/Library/Preferences"
suite_of() { echo "lithium-test-fast-$(basename "$1")"; }
find "$preferences" -maxdepth 1 -name 'lithium-test-fast-tmp.*.plist' -mmin +"$minutes" -delete 2>/dev/null
cleanup() {
    for home in ${homes[@]+"${homes[@]}"}; do
        rm -rf "$home"
        rm -f "$preferences/$(suite_of "$home").plist"
    done
}
trap cleanup EXIT

# Every test's identifier, Target.Suite/test() or Target.test() for a free function. Listing
# loads the test bundle, so it gets the sandbox and an empty home too. --ignore-lock takes
# SwiftPM's lock shared, so the shards' `swift test` runs don't wait for one another.
list_home=$(mktemp -d)
homes+=("$list_home")
CFFIXED_USER_HOME="$list_home" LITHIUM_NO_FILTER_UPDATES=1 LITHIUM_NO_EXTERNAL_OPEN=1 \
    sandbox-exec -p '(version 1) (allow default) (deny lsopen)' \
    swift test list --disable-sandbox --skip-build --ignore-lock ${build_args[@]+"${build_args[@]}"} >"$out/all-tests.txt" 2>"$out/list.log" || {
    echo "scripts/test-fast: couldn't list the tests:" >&2
    cat "$out/list.log" >&2
    exit 2
}

# SwiftPM keeps a test if any --filter matches its identifier and no --skip does. These are
# matched as extended regular expressions, which agree with Swift's for names and anchors.
selected=$out/selected-tests.txt
grep -E '^[^ ]+$' "$out/all-tests.txt" >"$selected"
if [ ${#filters[@]} -gt 0 ]; then
    patterns=()
    for f in "${filters[@]}"; do patterns+=(-e "$f"); done
    grep -E "${patterns[@]}" "$selected" >"$selected.tmp"
    mv "$selected.tmp" "$selected"
fi
if [ ${#skips[@]} -gt 0 ]; then
    patterns=()
    for s in "${skips[@]}"; do patterns+=(-e "$s"); done
    grep -v -E "${patterns[@]}" "$selected" >"$selected.tmp"
    mv "$selected.tmp" "$selected"
fi
if [ ! -s "$selected" ]; then
    echo "scripts/test-fast: no test matches." >&2
    exit 1
fi

# One unit per suite: a suite never splits across shards, since its tests may share static
# state. A target's free functions make one unit too. Each line of the plan:
#   shard  unit  tests  estimated-seconds  whole(1|0)  filter-fragment
# A whole suite's fragment is `Target\.Suite/`; part of one lists its tests, anchored at both
# ends, so `AgentTabs` never picks up `AgentTabsExtraTests`. The end is `$` or a `/`: Swift
# Testing matches a free function's identifier with its source location after it.
plan=$out/plan.tsv
mkdir -p "$(dirname "$timings")"
touch "$timings"
awk -F '\t' -v jobs="$jobs" -v fallback="$DEFAULT_SECONDS" -v media=" ${MEDIA_SUITES[*]} " '
    function escape(s) { gsub(/[][\\.*+?^$(){}|]/, "\\\\&", s); return s }
    function unit(id) { return index(id, "/") ? substr(id, 1, index(id, "/") - 1) : substr(id, 1, index(id, ".")) "(free functions)" }
    function suite(u) { return substr(u, index(u, ".") + 1) }
    FILENAME == ARGV[1] { measured[$1] = $2; next }
    FILENAME == ARGV[2] { total[unit($0)]++; next }
    {
        u = unit($0)
        if (!(u in count)) order[++units] = u
        count[u]++
        test = index($0, "/") ? substr($0, index($0, "/") + 1) : substr($0, index($0, ".") + 1)
        tests[u] = (u in tests ? tests[u] "|" : "") escape(test)
    }
    END {
        for (i = 1; i <= units; i++) {
            u = order[i]
            name = suite(u)
            whole = count[u] == total[u]
            seconds = (name in measured ? measured[name] : fallback) * count[u] / total[u]
            if (index(u, "(free functions)")) fragment = escape(substr(u, 1, index(u, "."))) "(" tests[u] ")($|/)"
            else if (whole) fragment = escape(u) "/"
            else fragment = escape(u) "/(" tests[u] ")($|/)"
            line[i] = u "\t" count[u] "\t" sprintf("%.1f", seconds) "\t" whole "\t" fragment
            estimate[i] = seconds
            lane[i] = index(media, " " name " ") > 0
        }
        # The media lane is shard 1. Then longest first, each unit to the least loaded shard.
        shards = 0
        for (i = 1; i <= units; i++) if (lane[i]) { shard[i] = 1; load[1] += estimate[i]; shards = 1 }
        for (n = shards + 1; n <= jobs; n++) load[n] = 0
        for (;;) {
            best = 0
            for (i = 1; i <= units; i++) if (!(i in shard) && (best == 0 || estimate[i] > estimate[best])) best = i
            if (best == 0) break
            least = 1
            for (n = 2; n <= jobs; n++) if (load[n] < load[least]) least = n
            shard[best] = least
            load[least] += estimate[best]
        }
        for (i = 1; i <= units; i++) print shard[i] "\t" line[i]
    }
' "$timings" "$out/all-tests.txt" "$selected" | sort -t "$(printf '\t')" -k1,1n -k4,4rn >"$plan.raw"
# Shards left empty (fewer units than jobs) drop out; the rest are numbered 1, 2, 3…
awk -F '\t' -v OFS='\t' '$1 != previous { previous = $1; n++ } { $1 = n; print }' "$plan.raw" >"$plan"
rm -f "$plan.raw"
shards=$(tail -n 1 "$plan" | cut -f 1)
media_shard=0
for suite in "${MEDIA_SUITES[@]}"; do
    if awk -F '\t' -v s="$suite" '{ sub(/^[^.]*\./, "", $2) } $2 == s { found = 1 } END { exit !found }' "$plan"; then
        media_shard=1
        break
    fi
done

describe() {
    awk -F '\t' -v n="$1" -v media="$media_shard" '
        $1 == n { tests += $3; seconds += $4; units = units "\n    " $2 " (" $3 " tests, ~" $4 " s)" }
        END { printf "shard %d%s: %d tests, ~%.0f s%s\n", n, (n == 1 && media ? " (media lane)" : ""), tests, seconds, units }
    ' "$plan"
}

if [ "$list_shards" -eq 1 ]; then
    for n in $(seq 1 "$shards"); do describe "$n"; done
    rm -rf "$out"
    exit 0
fi

now() { perl -MTime::HiRes=time -e 'printf "%.1f", time'; }
started=$(date '+%Y-%m-%d %H:%M:%S')
run_start=$(now)
deadline=$((SECONDS + minutes * 60))

# Each shard in a process group of its own, so it can be stopped whole. perl makes the group
# rather than set -m: job control in a bash that isn't a terminal's (an agent's session) failed
# to set the group, and `kill -- -pid` then hit a group the script didn't make. The
# environment is scripts/test's, with a home, temporary folder and hand-off log per shard:
# tests use the bundled filter lists, log unbuffered so a log cut short ends with the test
# really running, and nothing they do may open another app (ExternalApps only records,
# LithiumTestGuard refuses NSWorkspace's opens, the sandbox refuses LaunchServices' own).
# A separate home doesn't separate UserDefaults.standard, which cfprefsd keeps in the user's
# real Library/Preferences: LithiumTestGuard swaps it for a suite of the shard's own. (A suite
# given as a path in the shard's home didn't work: shards shared settings, or hung.)
for n in $(seq 1 "$shards"); do
    home=$(mktemp -d)
    homes+=("$home")
    mkdir "$home/tmp"
    filter="^($(awk -F '\t' -v n="$n" '$1 == n { printf "%s%s", (seen++ ? "|" : ""), $6 }' "$plan"))"
    printf '%s\n' "$filter" >"$out/shard-$n.filter"
    (
        CFFIXED_USER_HOME="$home" TMPDIR="$home/tmp/" LITHIUM_NO_FILTER_UPDATES=1 LITHIUM_NO_EXTERNAL_OPEN=1 \
            LITHIUM_HANDOFF_LOG="$out/shard-$n.handoffs.log" LITHIUM_DEFAULTS_SUITE="$(suite_of "$home")" NSUnbufferedIO=YES \
            perl -e 'setpgrp(0, 0); exec @ARGV' \
            sandbox-exec -p '(version 1) (allow default) (deny lsopen)' \
            swift test --disable-sandbox --skip-build --ignore-lock --no-parallel \
            ${test_args[@]+"${test_args[@]}"} --filter "$filter" >"$out/shard-$n.log" 2>&1 &
        echo $! >"$out/shard-$n.pid"
        wait $!
        echo "$? $(now)" >"$out/shard-$n.status"
    ) 2>/dev/null &
done
for n in $(seq 1 "$shards"); do
    while [ ! -s "$out/shard-$n.pid" ]; do sleep 0.1; done
done
echo "scripts/test-fast: $shards shards running, logs in $out"

group_of() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }
own_group=$(group_of $$)
caller_group=$(group_of "$PPID")
# Only a group this script made: the shard's pid leads it once perl has run setpgrp, and it is
# neither the script's group nor its caller's.
shard_group() {
    local pid group
    pid=$(cat "$out/shard-$1.pid")
    group=$(group_of "$pid")
    [ "$group" = "$pid" ] && [ "$group" != "$own_group" ] && [ "$group" != "$caller_group" ] && echo "$group"
}
descendants() {
    local child
    for child in $(pgrep -P "$1"); do echo "$child"; descendants "$child"; done
}
# Stops every unfinished shard and returns once its processes are gone. swift test starts the
# test helper outside the shard's group, so the shard's descendants are listed first and each
# gets SIGTERM too; the helper takes a few seconds to exit, and one still there after 5
# seconds is killed outright.
stop_all() {
    local n group pids="" alive pid
    for n in $(seq 1 "$shards"); do
        [ -f "$out/shard-$n.status" ] && continue
        group=$(shard_group "$n") || continue
        pids="$pids $(descendants "$group")"
        kill -- -"$group" 2>/dev/null
    done
    for pid in $pids; do kill "$pid" 2>/dev/null; done
    for _ in $(seq 50); do
        alive=""
        for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive="$alive $pid"; done
        [ -z "$alive" ] && return
        sleep 0.1
    done
    for pid in $alive; do kill -KILL "$pid" 2>/dev/null; done
}
# Out of the terminal's process group, the shards would outlive a ⌃C or a closed terminal.
# Exits 128 + the signal number, as if the signal had killed the script.
stop() { stop_all; exit $((128 + $1)); }
trap 'stop 1' HUP
trap 'stop 2' INT
trap 'stop 15' TERM

last_started() { grep -a '◇ Test .* started' "$1" | tail -n 1; }

# Polls rather than waits on each shard in turn, so the time limit and a signal are seen
# within a second whichever shard is still running.
timed_out=0
while :; do
    running=0
    for n in $(seq 1 "$shards"); do [ -f "$out/shard-$n.status" ] || running=$((running + 1)); done
    [ "$running" -eq 0 ] && break
    if [ "$SECONDS" -ge "$deadline" ]; then
        timed_out=1
        echo "scripts/test-fast: still running after $minutes minutes, stopped. Last test started in each unfinished shard:" >&2
        for n in $(seq 1 "$shards"); do
            [ -f "$out/shard-$n.status" ] && continue
            echo "  shard $n: $(last_started "$out/shard-$n.log")" >&2
        done
        stop_all
        break
    fi
    sleep 1
done
wait
wall=$(perl -e 'printf "%.1f", $ARGV[1] - $ARGV[0]' "$run_start" "$(now)")

# Measured times for the next plan, from suites that ran whole. A skipped suite takes no time.
cat "$out"/shard-*.log | awk -F '\t' '
    FILENAME == ARGV[1] { whole[substr($2, index($2, ".") + 1)] = $5; next }
    FILENAME == ARGV[2] { measured[$1] = $2; next }
    match($0, /Suite [^ ]+ (passed|failed) after [0-9.]+ seconds/) {
        split(substr($0, RSTART, RLENGTH), f, " ")
        if (whole[f[2]]) measured[f[2]] = f[5]
    }
    match($0, /Suite [^ ]+ skipped/) { split(substr($0, RSTART, RLENGTH), f, " "); if (whole[f[2]]) measured[f[2]] = 0 }
    END { for (s in measured) print s "\t" measured[s] }
' "$plan" "$timings" - 2>/dev/null | sort >"$timings.$$" && mv "$timings.$$" "$timings"

# Whatever passed, the run fails if it opened, or tried to open, another app on the user's
# screen, as in scripts/test.
handoffs=$out/handoffs.log
cat "$out"/shard-*.handoffs.log >"$handoffs" 2>/dev/null
launched=$(perl -e 'alarm 120; exec @ARGV' log show --start "$started" --style compact --predicate \
    '(process == "launchd" AND eventMessage CONTAINS "Successfully spawned") OR (eventMessage CONTAINS "deny" AND eventMessage CONTAINS "lsopen")' |
    grep -E '\[gui/[0-9]+/application\..*Successfully spawned|deny.*lsopen')
if [ -n "$launched" ] || [ -s "$handoffs" ]; then
    echo "scripts/test-fast: tests launched another app." >&2
    [ -n "$launched" ] && echo "$launched" >&2
    [ -s "$handoffs" ] && { echo "Hand-offs refused in the test processes ($handoffs):" >&2; cat "$handoffs" >&2; }
    app_launched=1
else
    echo "scripts/test-fast: no app launched since $started; no hand-off in $handoffs."
    app_launched=0
fi

# A shard with no summary line crashed or was stopped: its tests count as started, and it
# counts one issue so the run can't read as passed.
status=0
total_tests=0
total_suites=0
total_issues=0
failures=$out/failures.txt
: >"$failures"
for n in $(seq 1 "$shards"); do
    log=$out/shard-$n.log
    read -r code ended <"$out/shard-$n.status"
    summary=$(grep -a 'Test run with [0-9]* tests' "$log" | tail -n 1)
    if [ -n "$summary" ]; then
        tests=$(echo "$summary" | sed -E 's/.*Test run with ([0-9]+) tests?.*/\1/')
        suites=$(echo "$summary" | sed -nE 's/.* in ([0-9]+) suites?.*/\1/p')
        issues=$(echo "$summary" | sed -nE 's/.* with ([0-9]+) issues?.*/\1/p')
    else
        tests=$(grep -ac '◇ Test .* started' "$log")
        suites=$(awk -F '\t' -v n="$n" '$1 == n' "$plan" | wc -l | tr -d ' ')
        issues=1
    fi
    total_tests=$((total_tests + tests))
    total_suites=$((total_suites + ${suites:-0}))
    total_issues=$((total_issues + ${issues:-0}))
    failed=$(grep -a '✘ Test .* failed after' "$log" | grep -vc '✘ Test run')
    grep -a '✘ Test .* failed after' "$log" | grep -v '✘ Test run' | sed "s|\$|  ($log)|" >>"$failures"
    seconds=$(perl -e 'printf "%.1f", $ARGV[1] - $ARGV[0]' "$run_start" "$ended")
    note=""
    [ -z "$summary" ] && note=", no summary (crashed or stopped, exit $code; last started: $(last_started "$log"))"
    echo "shard $n: $tests tests, $failed failed, $seconds s$note"
    [ "$code" -ne 0 ] && [ "$status" -eq 0 ] && status=$code
done
cat "$failures"
[ "$timed_out" -eq 1 ] && [ "$status" -eq 0 ] && status=1
verdict=passed
[ "$status" -ne 0 ] && verdict=failed
[ "$app_launched" -eq 1 ] && [ "$status" -eq 0 ] && status=3
echo "Test run with $total_tests tests in $total_suites suites $verdict after $wall seconds with $total_issues issues."
echo "scripts/test-fast: logs in $out"
exit "$status"
