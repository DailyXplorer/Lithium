#!/bin/bash
# Runs the tests the way they pass every time: one test at a time, in a throwaway home folder,
# and never for longer than LITHIUM_TEST_MINUTES (20 by default). Arguments go to `swift test`:
#   scripts/test
#   scripts/test --filter BrowserTests
# A --filter or --skip that leaves no test to run fails the run.
#
# One at a time, because the suites that run a whole Browser share its settings and home
# folder (one sets tabs to fall asleep after 2 ms), and run side by side they slow and break
# each other.
set -u -m
cd "$(dirname "$0")/.."

minutes=${LITHIUM_TEST_MINUTES-20}
case $minutes in
    '' | *[!0-9]* | 0*)
        echo "scripts/test: LITHIUM_TEST_MINUTES must be a whole number of minutes above 0, not '$minutes'." >&2
        exit 2 ;;
esac

# The build runs before the watchdog starts, so compiling never eats into the time limit. It
# gets every argument except the ones only `swift test` knows, so both steps use the same
# configuration; an option missing from this list fails the build loudly instead of testing a
# stale binary.
build_args=()
scratch_path=0
test_value=""
# --filter and --skip patterns, kept to check below that they leave a test to run.
filters=()
skips=()
list_only=0
for arg in "$@"; do
    if [ -n "$test_value" ]; then
        case $test_value in
            --filter) filters+=(-e "$arg") ;;
            --skip) skips+=(-e "$arg") ;;
        esac
        test_value=""
        continue
    fi
    case $arg in
        --filter | --skip | --num-workers | --xunit-output | --attachments-path) test_value=$arg ;;
        --filter=*) filters+=(-e "${arg#--filter=}") ;;
        --skip=*) skips+=(-e "${arg#--skip=}") ;;
        --list-tests | -l) list_only=1 ;;
        --num-workers=* | --xunit-output=* | --attachments-path=* | --parallel | --no-parallel) ;;
        --scratch-path | --scratch-path=*) scratch_path=1; build_args+=("$arg") ;;
        *) build_args+=("$arg") ;;
    esac
done

# iCloud-synced folders tag build products with xattrs that break codesign; build outside them.
if [ "$scratch_path" -eq 0 ] && [ ! -L .build ]; then
    rm -rf .build
    mkdir -p "$HOME/Library/Caches/Lithium/build"
    ln -s "$HOME/Library/Caches/Lithium/build" .build
fi
# Generated by scripts/update-filters.py and not versioned; the build fails without the folder.
mkdir -p Sources/Lithium/Resources/Filters

swift build --build-tests ${build_args[@]+"${build_args[@]}"} || exit $?

home=$(mktemp -d)
trap 'rm -rf "$home"' EXIT

# `swift test` passes when --filter matches nothing (a typo, a renamed test), so a run that
# tested nothing would read as passed. The tests are listed first and matched as
# scripts/test-fast does: extended regular expressions, which agree with Swift's for names.
if { [ ${#filters[@]} -gt 0 ] || [ ${#skips[@]} -gt 0 ]; } && [ "$list_only" -eq 0 ]; then
    all_tests=$(CFFIXED_USER_HOME="$home" LITHIUM_NO_FILTER_UPDATES=1 LITHIUM_NO_EXTERNAL_OPEN=1 \
        sandbox-exec -p '(version 1) (allow default) (deny lsopen)' \
        swift test list --disable-sandbox --skip-build ${build_args[@]+"${build_args[@]}"} 2>"$home/list.log") || {
        echo "scripts/test: couldn't list the tests:" >&2
        cat "$home/list.log" >&2
        exit 2
    }
    selected=$(printf '%s\n' "$all_tests" | grep -E '^[^ ]+$')
    [ ${#filters[@]} -gt 0 ] && selected=$(printf '%s\n' "$selected" | grep -E "${filters[@]}")
    [ ${#skips[@]} -gt 0 ] && selected=$(printf '%s\n' "$selected" | grep -v -E "${skips[@]}")
    if [ -z "$selected" ]; then
        echo "scripts/test: no test matches the --filter and --skip given." >&2
        exit 1
    fi
fi
# The test bundle's LithiumTestGuard writes here every NSWorkspace open it refused, with its stack.
handoffs="${TMPDIR:-/tmp}/lithium-test-handoffs.log"
rm -f "$handoffs"
started=$(date '+%Y-%m-%d %H:%M:%S')

# Each in a process group of its own (set -m), so the watchdog can stop the whole test run.
# Tests use the bundled filter lists: an update would download and compile them in the middle
# of whatever test is running then (FilterUpdaterTests downloads them on purpose).
# Unbuffered, so a log the watchdog cuts short ends with the test that was really running:
# buffered, it lost the last few kilobytes and named a test that had already finished.
# Nothing a test does may open another app on the user's screen: ExternalApps only records,
# LithiumTestGuard refuses NSWorkspace's opens, and the sandbox refuses LaunchServices' own
# (a framework calling it directly), for the test process and everything it runs. SwiftPM's
# own sandbox can't nest in it.
CFFIXED_USER_HOME="$home" LITHIUM_NO_FILTER_UPDATES=1 LITHIUM_NO_EXTERNAL_OPEN=1 LITHIUM_HANDOFF_LOG="$handoffs" NSUnbufferedIO=YES \
    sandbox-exec -p '(version 1) (allow default) (deny lsopen)' swift test --disable-sandbox --skip-build --no-parallel "$@" &
tests=$!
(
    sleep $((minutes * 60))
    echo "scripts/test: still running after $minutes minutes, stopped. The last test started above is stuck." >&2
    kill -- -"$tests"
) &
watchdog=$!
# Out of the terminal's process group, the tests would outlive a ⌃C or a closed terminal.
# Exits 128 + the signal number, as if the signal had killed the script.
stop() { kill -- -"$tests" -"$watchdog" 2>/dev/null; exit $((128 + $1)); }
trap 'stop 1' HUP
trap 'stop 2' INT
trap 'stop 15' TERM

wait "$tests"
status=$?
kill -- -"$watchdog" 2>/dev/null
wait "$watchdog" 2>/dev/null

# Whatever passed, the run fails if it opened, or tried to open, another app on the user's
# screen: an app LaunchServices started while it ran (one the user opened meanwhile shows here
# too), an open the sandbox refused, or an NSWorkspace open the guard refused.
launched=$(perl -e 'alarm 120; exec @ARGV' log show --start "$started" --style compact --predicate \
    '(process == "launchd" AND eventMessage CONTAINS "Successfully spawned") OR (eventMessage CONTAINS "deny" AND eventMessage CONTAINS "lsopen")' |
    grep -E '\[gui/[0-9]+/application\..*Successfully spawned|deny.*lsopen')
if [ -n "$launched" ] || [ -s "$handoffs" ]; then
    echo "scripts/test: tests launched another app." >&2
    [ -n "$launched" ] && echo "$launched" >&2
    [ -s "$handoffs" ] && { echo "Hand-offs refused in the test process ($handoffs):" >&2; cat "$handoffs" >&2; }
    [ "$status" -eq 0 ] && status=3
else
    echo "scripts/test: no app launched since $started; no hand-off in $handoffs."
fi
exit "$status"
